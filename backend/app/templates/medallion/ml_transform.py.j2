"""Reusable ML/Python transform operator, deposited once per Airflow stack (plugins/).
Runs an engineer-authored `python_code` snippet against the warehouse, exposing only a
minimal read_table(name) / write_table(df, name) contract — the snippet never opens its
own connection, exactly like dbt models never see credentials directly.
"""
import logging

import pandas as pd
from dataplateforme_ingest import _sql_engine, _write_chunk

logger = logging.getLogger(__name__)


def run_ml_transform(warehouse_conn_id: str, input_schemas: dict, output_schema: str, python_code: str, **context) -> None:
    engine = _sql_engine(warehouse_conn_id)

    def read_table(name: str) -> pd.DataFrame:
        schema = input_schemas.get(name)
        if schema is None:
            raise ValueError(f"Table amont inconnue pour ce nœud : {name!r}. Tables disponibles : {sorted(input_schemas)}")
        query = f'SELECT * FROM "{schema}"."{name}"'
        # Same raw-cursor read as ingest_bronze: pandas.read_sql misbehaves against
        # Airflow's pinned SQLAlchemy 1.4.x under pandas>=2.
        with engine.connect() as raw_conn:
            cursor = raw_conn.connection.cursor()
            cursor.execute(query)
            columns = [c[0] for c in cursor.description]
            rows = cursor.fetchall()
            cursor.close()
        return pd.DataFrame(rows, columns=columns)

    def write_table(df: pd.DataFrame, name: str) -> None:
        _write_chunk(engine, output_schema, name, df, replace=True)
        logger.info("ML transform wrote %s rows to %s.%s", len(df), output_schema, name)

    exec_globals = {"read_table": read_table, "write_table": write_table, "pd": pd}
    exec(python_code, exec_globals)
