"""Auto-generated by Data Plateforme — do not edit by hand, changes will be overwritten
on the next "Build & déployer". Project: {{ project.name }} (id={{ project.id }})."""
from datetime import datetime

from airflow import DAG
from airflow.providers.standard.operators.python import PythonOperator
from airflow.providers.standard.operators.bash import BashOperator
from airflow.utils.trigger_rule import TriggerRule
from dataplateforme_ingest import ingest_bronze
from dataplateforme_dbt_run import run_dbt
{% if ml_nodes %}
from dataplateforme_ml_transform import run_ml_transform
{% endif %}

DBT_PROJECT_DIR = "{{ dbt_project_dir }}"
DBT_BIN = "{{ dbt_bin }}"

default_args = {
    "owner": "dataplateforme",
    "retries": 1,
}

with DAG(
    dag_id="{{ dag_id }}",
    description="{{ project.description or ('Pipeline medaillon pour ' ~ project.name) }}",
    schedule={{ (project.schedule | tojson) if project.schedule else "None" }},
    start_date=datetime({{ created_year }}, {{ created_month }}, {{ created_day }}),
    catchup=False,
    max_active_runs=1,
    default_args=default_args,
    tags=["dataplateforme", "medallion"],
) as dag:

{% for b in bronze_datasets %}
    bronze_{{ b.safe_name }} = PythonOperator(
        task_id="ingest_bronze_{{ b.safe_name }}",
        python_callable=ingest_bronze,
        op_kwargs={
            "source_conn_id": "{{ b.source_conn_id }}",
            "source_object": "{{ b.source_object }}",
            "warehouse_conn_id": "{{ warehouse_conn_id }}",
            "bronze_table": "{{ b.name }}",
            "object_store_conn_id": "{{ object_store_conn_id }}",
            "bronze_bucket": "{{ bronze_bucket }}",
            "load_mode": "{{ b.load_mode }}",
            "incremental_key": {{ (b.incremental_key | tojson) if b.incremental_key else "None" }},
        },
    )
{% endfor %}

    # Module 16 extension §1/§4 — installs dbt-expectations/dbt-utils when at least one
    # contract check is materialized (packages.yml then present); a project that materializes
    # nothing has no packages.yml and this is a harmless no-op ("No packages were found").
    # Always runs, on every DAG run, so packages stay resolved regardless of which build wrote
    # the current packages.yml.
    dbt_deps = BashOperator(
        task_id="dbt_deps",
        bash_command=f"{DBT_BIN} deps --project-dir {DBT_PROJECT_DIR} --profiles-dir {DBT_PROJECT_DIR}",
    )

    # Module 18 §8 — dq_flag_registry (platform-wide, admin-managed) must be loaded before any
    # hand-written 05_validated/05_quarantine that refs() it can build. Always runs, like
    # dbt_deps: harmless no-op if a project's hand-written SQL never actually uses it.
    dbt_seed = BashOperator(
        task_id="dbt_seed",
        bash_command=f"{DBT_BIN} seed --project-dir {DBT_PROJECT_DIR} --profiles-dir {DBT_PROJECT_DIR} --target {{ project.target.value }}",
    )

    # Module 6 extension (payload & structuration) §5 — bronze itself is never a dbt MODEL
    # (it's declared as a dbt source, populated by the ingest_bronze operators above), but a
    # payload dataset's structuration (01_unpacked_<name>/02_typed_<name>, and any hand-written
    # 03_standardized/04_annotated/05_validated/05_quarantine an engineer authored on top) IS
    # one — all of it lives under models/silver/, so the plain `silver` selector picks up the
    # whole chain, whatever length it happens to be for a given bronze dataset. PythonOperator
    # (not Bash) so run_dbt can read dag_run.conf directly for the RUN-button's scoped runs
    # (see dataplateforme_dbt_run.py) without any Airflow-Jinja templating in the command —
    # an empty/absent conf (every run before this feature, and every scheduled one since)
    # behaves exactly like the plain `--select silver`/`gold` BashOperator did.
    # trigger_rule=NONE_FAILED (not the default ALL_SUCCESS) on every task from here down —
    # a scoped run's ingest_bronze/ml tasks for datasets outside the target's closure skip
    # themselves (AirflowSkipException), and ALL_SUCCESS treats an upstream "skipped" the
    # same as a failure, auto-skipping every downstream task in turn even when it legitimately
    # has its own work to do (e.g. dbt_run_silver still has real models to build even though
    # some unrelated bronze ingest was skipped). Each task's own run_dbt()/skip-check is what
    # actually decides whether there's anything to do — this just stops Airflow's default
    # propagation from deciding that for them first.
    dbt_run_silver = PythonOperator(
        task_id="dbt_run_silver",
        python_callable=run_dbt,
        trigger_rule=TriggerRule.NONE_FAILED,
        op_kwargs={
            "dbt_bin": DBT_BIN, "project_dir": DBT_PROJECT_DIR, "profiles_dir": DBT_PROJECT_DIR,
            "dbt_target": "{{ project.target.value }}", "subcommand": "run", "layer": "silver",
            "progress_file": "dp_progress_silver.jsonl", "result_snapshot": "dp_results_silver.json",
        },
    )

    dbt_run_gold = PythonOperator(
        task_id="dbt_run_gold",
        python_callable=run_dbt,
        trigger_rule=TriggerRule.NONE_FAILED,
        op_kwargs={
            "dbt_bin": DBT_BIN, "project_dir": DBT_PROJECT_DIR, "profiles_dir": DBT_PROJECT_DIR,
            "dbt_target": "{{ project.target.value }}", "subcommand": "run", "layer": "gold",
            "progress_file": "dp_progress_gold.jsonl", "result_snapshot": "dp_results_gold.json",
        },
    )

    dbt_test = PythonOperator(
        task_id="dbt_test",
        python_callable=run_dbt,
        trigger_rule=TriggerRule.NONE_FAILED,
        op_kwargs={
            "dbt_bin": DBT_BIN, "project_dir": DBT_PROJECT_DIR, "profiles_dir": DBT_PROJECT_DIR,
            "dbt_target": "{{ project.target.value }}", "subcommand": "test",
        },
    )

{% for m in ml_nodes %}
    ml_{{ m.safe_name }} = PythonOperator(
        task_id="ml_{{ m.safe_name }}",
        python_callable=run_ml_transform,
        trigger_rule=TriggerRule.NONE_FAILED,
        op_kwargs={
            "warehouse_conn_id": "{{ warehouse_conn_id }}",
            "input_schemas": {{ m.input_schemas | tojson }},
            "output_schema": "gold",
            "python_code": {{ m.python_code_repr | safe }},
            "node_name": "{{ m.output_table }}",
        },
    )
{% endfor %}

{% if bronze_datasets %}
    [{% for b in bronze_datasets %}bronze_{{ b.safe_name }}{{ ", " if not loop.last }}{% endfor %}] >> dbt_run_silver
{% endif %}
    dbt_deps >> dbt_seed >> dbt_run_silver
    dbt_run_silver >> dbt_run_gold
{% if ml_nodes %}
    dbt_run_gold >> [{% for m in ml_nodes %}ml_{{ m.safe_name }}{{ ", " if not loop.last }}{% endfor %}] >> dbt_test
{% else %}
    dbt_run_gold >> dbt_test
{% endif %}
