{
  "_meta": {
    "purpose": "Catalogue de capacités des viz_type Superset pour la suggestion d'indicateurs (Module 12). L'IA reçoit UNIQUEMENT `intent` + `data_slots` de chaque entrée. Elle ne remplit QUE les slots de données. Tout le reste du params Superset (couleur, police, légende, labels, format...) est figé dans le template capturé (§3.2), jamais généré par l'IA.",
    "captured_from": "apache/superset master (MainPreset.ts + VizType.ts + controlPanels)",
    "IMPORTANT_version": "Les clés (_v2, ag_grid, heatmap_v2, bubble_v2, sankey_v2, sunburst_v2, treemap_v2...) et la structure params varient selon la version. REVALIDER contre SUPERSET_MIN_VERSION avant de figer les templates.",
    "aggregation_whitelist": ["SUM", "AVG", "COUNT", "COUNT_DISTINCT", "MIN", "MAX"],
    "slot_roles": {
      "measure": "colonne numérique agrégée (aggregation obligatoire)",
      "dimension": "colonne catégorielle (groupby)",
      "temporal": "colonne date/timestamp",
      "raw_column": "colonne brute non agrégée (détail tabulaire)",
      "geo_point": "couple latitude/longitude",
      "geo_region_code": "code pays/région ISO",
      "geo_polygon": "colonne polygone / GeoJSON",
      "node": "identifiant de noeud (graphe/flux)",
      "hierarchy_id": "identifiant d'un noeud d'arbre",
      "hierarchy_parent": "identifiant du parent d'un noeud d'arbre"
    },
    "preconditions_vocab": {
      "has_measure": ">=1 colonne numerique dans le profil",
      "has_dimension": ">=1 colonne categorielle",
      "has_temporal": ">=1 colonne date/timestamp",
      "measures_gte_2": ">=2 colonnes numeriques",
      "measures_gte_3": ">=3 colonnes numeriques",
      "has_geo_point": "latitude + longitude detectees",
      "has_geo_region_code": "colonne de code pays/region ISO detectee",
      "has_geo_polygon": "colonne polygone/GeoJSON detectee",
      "has_graph_edges": "au moins 2 colonnes id-like formant des relations",
      "has_hierarchy": "colonne id + colonne parent detectees"
    },
    "suggestion_rule": "Un viz_type n'est proposable a l'IA (et un indicateur n'est accepte a la validation) QUE si TOUTES ses `requires` sont satisfaites par le profil de la table gold. Sinon il est retire du menu / rejete. status='excluded' => jamais propose.",
    "ranking_rule": "Un viz_type avec `supports_ranking: true` accepte un champ optionnel `ranking: {limit, direction}` sur l'indicateur (hors `slots`) pour exprimer un classement Top N (direction=top, valeurs les plus hautes) ou Bottom N (direction=bottom, valeurs les plus basses) sur son premier metric. limit entre 1 et 100. Absent des types sans supports_ranking."
  },

