ENV=dev

DATABASE_URL=postgresql+psycopg://dataplateforme:dataplateforme@localhost:5432/dataplateforme

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=change-me
SMTP_TLS=true

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Self-hosted Mistral (OpenAI-compatible API), on a VM external to the platform's own
# stacks — reached directly via this URL, never provisioned/managed by Module 1.
# MISTRAL_BASE_URL is the root of the API, WITHOUT the /v1 suffix (e.g. http://10.0.0.5:8000).
MISTRAL_BASE_URL=http://10.0.0.5:8000
MISTRAL_API_KEY=change-me
MISTRAL_MODEL=mistral-small
MISTRAL_VERIFY_TLS=false
MISTRAL_TIMEOUT=30

# Module 6 extension — File Watcher. WATCH_LOCAL_BASE must be an absolute path mounted into
# the backend container if any watch uses transport=local; leave empty to disable local
# transport entirely (MinIO-backed watches are unaffected).
WATCH_TICK_SECONDS=30
WATCH_LOCAL_BASE=
WATCH_REGEX_TIMEOUT_MS=2000
WATCH_MAX_CONSECUTIVE_FAILURES=3
