# Copy to .env on the VM (same directory as docker-compose.prod.yml) and fill in.
# Never commit the real .env.

# --- images ---
DOCKERHUB_NAMESPACE=delomidit
BACKEND_IMAGE_TAG=1.15.3
FRONTEND_IMAGE_TAG=1.15.6

# --- ports published on the VM ---
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- public URLs (as reached from a browser / from the backend's CORS check) ---
# The IP or domain of this VM. FRONTEND_URL is compared to the browser's exact `Origin`
# header for CORS — browsers never include a default port in Origin, so if FRONTEND_PORT
# is 80 (http) or 443 (https), do NOT add ":80"/":443" here or every request gets CORS-blocked.
FRONTEND_URL=http://VM_HOST
BACKEND_PUBLIC_URL=http://VM_HOST:8000

# --- control-plane database ---
POSTGRES_USER=dataplateforme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dataplateforme

# --- secrets ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# --- SMTP (Module 0 — password reset, invitations; Module 5 — quality notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=change-me
SMTP_TLS=true

# --- bootstrap admin (idempotent — created once, on first start) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Module 12 — self-hosted Mistral (OpenAI-compatible), on a VM external to this
# deployment. Optional: leave blank if the client has no Mistral VM yet — AI features
# just report "unreachable" until filled in. MISTRAL_BASE_URL is the API root, WITHOUT
# the /v1 suffix (e.g. http://10.0.0.5:8000).
MISTRAL_BASE_URL=http://10.0.0.5:11434
MISTRAL_API_KEY=change-me
MISTRAL_MODEL=qwen3-coder:30b
MISTRAL_VERIFY_TLS=false
MISTRAL_TIMEOUT=30
